# Jev State is a local, open-source workspace. No account or payment setup is required.
# Public demo mode disables provider calls even if keys are accidentally present.
STUDIO_PUBLIC_DEMO=0
# Optional: let visitors connect their own keys in tab memory. No database needed.
# Public demo mode above overrides this and disables all live calls.
STUDIO_BYOK=0

# Server-side only. Never use VITE_ or NEXT_PUBLIC_ for private variables.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_LOG_LEVEL=warn

# Optional: enables OpenAI-generated conversational replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional local access gate for a shared machine. Leave empty for an open local workspace.
STUDIO_ACCESS_TOKEN=
# For a non-Vercel deployment, set its exact origin (no trailing slash).
# STUDIO_ORIGIN=https://studio.example.com

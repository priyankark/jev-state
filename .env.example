# Local is free and works without accounts. Set cloud for Supabase accounts.
STUDIO_MODE=local
# Server-side only. Never use VITE_ or NEXT_PUBLIC_ for private variables.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_LOG_LEVEL=warn
# Optional: enables OpenAI-generated conversational replies.
OPENAI_API_KEY=
# Required for hosted local mode; not used for cloud account sign-in.
STUDIO_ACCESS_TOKEN=

# Cloud mode: apply supabase/migrations before starting.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exactly 32 random bytes encoded as base64. Back up securely.
CREDENTIAL_ENCRYPTION_KEY=
GITHUB_AUTH_ENABLED=false
# Enable only after configuring production SMTP in Supabase.
EMAIL_AUTH_ENABLED=false
APP_URL=http://localhost:5173
SUPPORT_EMAIL=

# Optional hosted subscriptions. Defaults to test mode; no real charges.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
